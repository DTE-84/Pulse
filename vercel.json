{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/data-retention-policy", "destination": "/data-retention-policy.html" },
    { "source": "/information-security-policy", "destination": "/information-security-policy.html" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}