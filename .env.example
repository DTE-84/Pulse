# ─────────────────────────────────────────────────────────────────────────────
# Pulse Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVER ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── JWT (REQUIRED — server will not start without this) ─────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters. Never use the example value below in production.
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_STRING

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pulse

# ── CORS (comma-separated list of allowed frontend origins) ──────────────────
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (replace with your actual domain):
# ALLOWED_ORIGINS=https://your-pulse-domain.com

# ── SUPABASE (for Next.js / client-side features) ────────────────────────────
# Use the ANON/PUBLISHABLE key only — NEVER the service_role key in client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ── SUPABASE SERVICE ROLE (server-side ONLY — keep secret) ──────────────────
# Required for Guest Sandbox seeding and admin operations.
# NEVER expose this to the client/frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI (GOOGLE GEMINI) ──────────────────────────────────────────────────────
# Required for Nova Chat and Deep Scan features.
# Get a key at: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=your-google-ai-key-here

# ── PLAID (FINANCIAL UPLINK) ────────────────────────────────────────────────
# Get these at: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,auth
PLAID_COUNTRY_CODES=US

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
PING_MESSAGE=pulse-online

# ── SANDBOX / DEMO ──────────────────────────────────────────────────────────
# UUID of the stable sandbox user in Supabase Auth.
# Guest/demo logins reuse this identity instead of creating new users.
# Must exist in both auth.users and dim_users.
SANDBOX_USER_ID=your-sandbox-user-uuid-here