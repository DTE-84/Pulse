{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "jsxImportSource": "react",

    "jsxFactory": "React.createElement",

    "importHelpers": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "node"
  }
}
