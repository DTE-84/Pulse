{
  "name": "fusion-starter",
  "private": true,
  "type": "module",
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "vite --config vite.config.server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest --run",
    "format.fix": "prettier --write .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "axios": "^1.13.6",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^20.4.1",
    "undici": "^7.24.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.3.0",
    "vite": "^8.0.0"
  }
}
